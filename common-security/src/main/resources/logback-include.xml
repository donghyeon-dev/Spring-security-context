<?xml version="1.0" encoding="UTF-8"?>
<included>
    <property name="LOG_PATTERN"
              value="%d{HH:mm:ss.SSS} %-5level [%X{traceId:-}/%X{spanId:-}] [%X{tenantId:-}/%X{userId:-}/%X{tokenId:-}/%X{requestId:-}] [%X{authSource:-}] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</included>
